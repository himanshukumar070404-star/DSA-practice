class Solution {

    public int kthFactor(int n, int k) {
// Checking factor for kth element by usinf mod and after that k-- decreases when the factor is found and remin still if not found
        for (int i = 1; i <= n; i++) {

            if (n % i == 0) {

                k--;

                if (k == 0) {
                    return i;
                }
            }
        }

        return -1;
    }
}
